{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "hoksiyo-backend",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	// No public URL: the only way in is hoksiyo-frontend's service binding,
	// which checks the access code first.
	"workers_dev": false,
	"preview_urls": false,
	// Workers Traces shows each agent response as a trace with agent-level
	// spans: https://flueframework.com/docs/guide/observability/#cloudflare
	"observability": { "traces": { "enabled": true } },
	// Keyless `cloudflare/...` models run through this Workers AI binding.
	// It reaches your Cloudflare account even in local dev:
	// https://flueframework.com/docs/guide/models/#cloudflare-workers-ai-cloudflare-only
	"ai": { "binding": "AI" },
	// Every agent generates a Durable Object class named after its identity
	// (Hello -> FlueHelloAgent), and Cloudflare requires a migration entry
	// for each one. Append a new tag when you add an agent:
	// https://flueframework.com/docs/guide/cloudflare-target/#managing-migrations
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["FlueHelloAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["FlueAnalyzeFeedbackAgent"] },
		{ "tag": "v3", "new_sqlite_classes": ["UsageCounter"] },
	],
	// Daily Neurons ledger (src/usage/usage-counter.ts). Every /api/analyze call
	// reserves against it before any model call.
	"durable_objects": {
		"bindings": [{ "name": "USAGE_COUNTER", "class_name": "UsageCounter" }],
	},
	// Usage budget (src/usage/budget.ts). Override locally in .env; the free
	// allocation is shared by local dev and deploys, so split it between them.
	"vars": {
		"DAILY_NEURON_LIMIT": "9000",
		"USAGE_WORST_BASE": "1800",
		"USAGE_WORST_PER_SENTENCE": "400",
		"USAGE_CORRECTION_FACTOR": "1.0",
		"MAX_SENTENCES": "12",
	}
}
